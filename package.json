{
  "name": "jev-router",
  "version": "0.4.1",
  "description": "Fork of jev-router for Claude Code: routes each turn to the model that gets the best result for the least cost, using TypeSafe Jev",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alienfacepalm/jev-claude.git"
  },
  "homepage": "https://github.com/alienfacepalm/jev-claude#readme",
  "bugs": "https://github.com/alienfacepalm/jev-claude/issues",
  "bin": {
    "jev-claude": "bin/jev-claude.mjs",
    "jev-codex": "bin/jev-codex.mjs",
    "jev-explain": "bin/jev-explain.mjs"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "pnpm test"
  },
  "files": [
    ".claude/skills",
    "bin",
    "skills",
    "src",
    "README.md",
    ".env.example"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "model-routing",
    "jev",
    "typesafe"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "packageManager": "pnpm@12.4.2"
}
