#!/bin/sh
# Claude Code as Lattis launches it, routed through jev-router.
#
# Lattis finds agent CLIs by name on PATH and its AgentKind is a fixed five-variant enum
# (Claude, Codex, Pi, OpenCode, Sawyer), so there is no sixth row to add: making its Claude
# row route means standing in front of `claude` itself. Everywhere else - a terminal, a
# script, Claude Code's own self-update - this hands straight to the real binary, so only
# Lattis's sessions change.
#
# To use it, put this file first on Lattis's PATH, ahead of the folder that holds the real
# `claude`. Overrides: JEV_REAL_CLAUDE (the real Claude Code) and JEV_NATIVE (the launcher).

# The folder this shim runs from, as given and with symlinks resolved. The PATH searches below
# skip it, so they never find the shim itself, or a link beside it, instead of the real program.
# They also skip any file that is this shim under another name (`-ef`: same device and inode, so a
# symlink or hard link in another PATH folder): two such copies would otherwise pick each other as
# the real program and exec back and forth forever.
SELF_DIR=$(dirname "$0")
SELF_REAL=$(cd "$SELF_DIR" 2>/dev/null && pwd -P) || SELF_REAL=$SELF_DIR

# Prints the first executable $1 on PATH outside the shim's folder that is not the shim itself;
# fails when there is none.
# Empty entries (the current directory) are skipped: what a project folder holds is not trusted.
# PATH is taken apart by hand rather than by word splitting, so no IFS or globbing is involved.
on_path() {
  _jev_rest="$PATH:"
  while [ -n "$_jev_rest" ]; do
    _jev_dir=${_jev_rest%%:*}
    _jev_rest=${_jev_rest#*:}
    case "$_jev_dir" in "" | . | "$SELF_DIR") continue ;; esac
    if [ -f "$_jev_dir/$1" ] && [ -x "$_jev_dir/$1" ] && ! [ "$_jev_dir/$1" -ef "$0" ] &&
      [ "$(cd "$_jev_dir" 2>/dev/null && pwd -P)" != "$SELF_REAL" ]; then
      printf '%s\n' "$_jev_dir/$1"
      return 0
    fi
  done
  return 1
}

# Claude Code's native installer puts it in ~/.local/bin; an npm install lives elsewhere on PATH.
# A REAL that is the shim (in its own folder, or a link to it elsewhere) would exec itself forever.
REAL="${JEV_REAL_CLAUDE:-${HOME:-}/.local/bin/claude}"
if [ ! -x "$REAL" ] || [ "$REAL" -ef "$0" ] ||
  [ "$(cd "$(dirname "$REAL")" 2>/dev/null && pwd -P)" = "$SELF_REAL" ]; then
  REAL=$(on_path claude) || {
    echo "[jev] shim: the real Claude Code was not found (set JEV_REAL_CLAUDE to its path)." >&2
    exit 127
  }
fi

# jev-claude resolves `claude` from PATH and would find this shim again. The marker it is
# given on the way in sends that second call to the real binary instead of looping.
if [ -n "${JEV_SHIM:-}" ]; then
  exec "$REAL" "$@"
fi

# Lattis keeps a Claude sign-in of its own and points CLAUDE_CONFIG_DIR at it; its agent
# token is the second signal, for a launch that does not carry the config dir. The folder name is
# matched in any letter case (`Lattis` on macOS's Application Support, for example).
case "${CLAUDE_CONFIG_DIR:-}" in
  *[Ll][Aa][Tt][Tt][Ii][Ss]*) ;;
  *)
    if [ -z "${LATTIS_AGENT_TOKEN:-}" ]; then
      exec "$REAL" "$@"
    fi
    ;;
esac

# The native launcher: JEV_NATIVE, else `jev-claude` on PATH (the installer links it into
# ~/.local/bin), else the install folder itself, for a PATH that lacks the link. It is a compiled
# program, so it needs no interpreter and no shebang.
NATIVE=""
if [ -n "${JEV_NATIVE:-}" ] && [ -x "$JEV_NATIVE" ]; then
  NATIVE=$JEV_NATIVE
elif FOUND=$(on_path jev-claude); then
  NATIVE=$FOUND
elif [ -x "${HOME:-}/jev-claude-rust/bin/jev-claude" ]; then
  NATIVE="${HOME:-}/jev-claude-rust/bin/jev-claude"
fi

# No launcher installed: Lattis's Claude row must keep working, so it gets plain Claude Code.
if [ -z "$NATIVE" ]; then
  exec "$REAL" "$@"
fi

JEV_SHIM=1
export JEV_SHIM
exec "$NATIVE" "$@"
